# `mock` lets the API run without a database. Change only after creating
# the read-only TeslaMate PostgreSQL user described in docs/LOCAL_SETUP.md.
DATA_SOURCE=mock
TESLA_BUDDY_MODEL_NAME=Model YL · Dual Motor
HOST=127.0.0.1
PORT=8787

# Required when DATA_SOURCE=postgres. Use the dedicated read-only role.
TESLAMATE_DATABASE_URL=postgresql://tesla_companion_reader:CHANGE_ME@127.0.0.1:5432/teslamate
