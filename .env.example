# `mock` lets the API run without a database. Change only after creating
# the read-only TeslaMate PostgreSQL user described in docs/LOCAL_SETUP.md.
DATA_SOURCE=mock
TESLA_BUDDY_MODEL_NAME=Model YL · Dual Motor
HOST=0.0.0.0
PORT=8787
TESLA_BUDDY_API_TOKEN=replace-with-a-long-random-token

# Required when DATA_SOURCE=postgres. Use the dedicated read-only role.
TESLAMATE_DATABASE_URL=postgresql://tesla_companion_reader:CHANGE_ME@127.0.0.1:5432/teslamate

# Vehicle software update detection (optional). Local broker is loopback-only.
TESLAMATE_MQTT_URL=mqtt://127.0.0.1:1883
# If TeslaMate uses MQTT_NAMESPACE, use teslamate/<namespace> here.
TESLAMATE_MQTT_TOPIC_PREFIX=teslamate
# TESLAMATE_MQTT_USERNAME=
# TESLAMATE_MQTT_PASSWORD=

# WeChat mini program subscribe messages for software update reminders (optional).
# AppSecret comes from 小程序后台「开发管理 > 开发设置」; keep it only on the server.
# WECHAT_APP_ID=wx0000000000000000
# WECHAT_APP_SECRET=
# Template from 「订阅消息」; map its keywords with {vehicle} {target} {current} {hint} {time}.
# WECHAT_UPDATE_TEMPLATE_ID=
# WECHAT_UPDATE_TEMPLATE_DATA={"thing1":"{vehicle}","character_string2":"{target}","thing3":"{hint}"}
# WECHAT_MINIPROGRAM_STATE=formal
# Must be writable and persistent (mount a volume in Docker).
# WECHAT_SUBSCRIPTION_STORE=data/wechat-subscriptions.json
