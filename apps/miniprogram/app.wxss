/* Visual language follows WeChat mini program design guidelines (WeUI):
   grey page background, white grouped cells, hairline separators,
   WeChat green as the single accent and system fonts. */
page {
  --brand: #07c160;
  --brand-weak: rgba(7, 193, 96, 0.1);
  --link: #576b95;
  --warn: #fa5151;
  --orange: #fa9d3b;
  --blue: #10aeff;
  --bg: #ededed;
  --card: #ffffff;
  --fg-0: rgba(0, 0, 0, 0.9);
  --fg-1: rgba(0, 0, 0, 0.55);
  --fg-2: rgba(0, 0, 0, 0.3);
  --line: rgba(0, 0, 0, 0.1);
  --fill: rgba(0, 0, 0, 0.05);
  background: var(--bg);
  color: var(--fg-0);
  font-family: -apple-system-font, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 34rpx;
  line-height: 1.4;
}

@media (prefers-color-scheme: dark) {
  page {
    --brand-weak: rgba(7, 193, 96, 0.18);
    --link: #7d90a9;
    --bg: #111111;
    --card: #191919;
    --fg-0: rgba(255, 255, 255, 0.85);
    --fg-1: rgba(255, 255, 255, 0.5);
    --fg-2: rgba(255, 255, 255, 0.3);
    --line: rgba(255, 255, 255, 0.08);
    --fill: rgba(255, 255, 255, 0.06);
  }
}

view, text, button, navigator { box-sizing: border-box; }

.page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); min-height: 100vh; }
.pad { padding: 0 32rpx; }

/* Section headings and footers (weui-cells__title / __tips) */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 48rpx 32rpx 16rpx;
  font-size: 28rpx;
  color: var(--fg-1);
}
.section-title .strong { font-size: 34rpx; font-weight: 600; color: var(--fg-0); }
.section-tips { padding: 16rpx 32rpx 0; font-size: 26rpx; color: var(--fg-1); line-height: 1.6; }

/* Grouped cells */
.cells { background: var(--card); position: relative; }
.cells.inset { margin: 0 32rpx; border-radius: 16rpx; overflow: hidden; }
.cell {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 24rpx 32rpx;
  font-size: 34rpx;
}
.cell + .cell::before {
  content: "";
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 0;
  border-top: 1rpx solid var(--line);
}
.cell.indent + .cell.indent::before { left: 104rpx; }
.cell-icon { width: 48rpx; height: 48rpx; margin-right: 24rpx; flex-shrink: 0; }
.cell-bd { flex: 1; min-width: 0; }
.cell-ft { color: var(--fg-1); font-size: 32rpx; text-align: right; margin-left: 16rpx; }
.cell-desc { display: block; font-size: 26rpx; color: var(--fg-1); margin-top: 6rpx; }
.cell.access .cell-ft::after, .cell.access.no-ft::after {
  content: "";
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  margin-left: 16rpx;
  border-top: 3rpx solid var(--fg-2);
  border-right: 3rpx solid var(--fg-2);
  transform: rotate(45deg) translateY(-3rpx);
}
.cell-hover { background: var(--fill); }
.link { color: var(--link); }
.warn { color: var(--warn); }
.brand { color: var(--brand); }
.muted { color: var(--fg-1); }
.faint { color: var(--fg-2); }
.small { font-size: 26rpx; }
.tiny { font-size: 22rpx; }
.bold { font-weight: 600; }
.num { font-variant-numeric: tabular-nums; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

/* Cards */
.card { background: var(--card); border-radius: 16rpx; padding: 32rpx; margin: 0 32rpx; }
.card + .card { margin-top: 24rpx; }
.card-title { display: flex; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 600; margin-bottom: 24rpx; }

/* Summary strip used by drive and charge periods */
.metrics { display: flex; }
.metric { flex: 1; min-width: 0; padding-left: 20rpx; border-left: 1rpx solid var(--line); }
.metric:first-child { padding-left: 0; border-left: none; }
.metric-value { font-size: 30rpx; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.metric-label { font-size: 22rpx; color: var(--fg-1); margin-top: 4rpx; }

/* Two column tiles */
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.tile { background: var(--fill); border-radius: 12rpx; padding: 24rpx; min-height: 150rpx; }
.tile-value { font-size: 36rpx; font-weight: 600; margin-top: 12rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tile-label { font-size: 24rpx; color: var(--fg-1); margin-top: 4rpx; }

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--brand);
  background: var(--brand-weak);
}
.tag.warn { color: var(--warn); background: rgba(250, 81, 81, 0.1); }
.tag.grey { color: var(--fg-1); background: var(--fill); }

.notice { display: flex; align-items: flex-start; gap: 12rpx; margin: 24rpx 32rpx 0; font-size: 26rpx; color: var(--fg-1); line-height: 1.6; }
.notice.warn { color: var(--orange); }

/* WeUI primary button */
.btn {
  display: block;
  width: auto;
  margin: 0;
  padding: 20rpx 48rpx;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #fff;
  background: var(--brand);
}
.btn::after { border: none; }
.btn.mini { display: inline-block; padding: 12rpx 36rpx; font-size: 28rpx; }
.btn.plain { color: var(--brand); background: var(--fill); }
.btn-hover { opacity: 0.8; }
button.cell-button { width: 100%; background: transparent; padding: 0; margin: 0; text-align: left; font-size: inherit; line-height: inherit; color: inherit; border-radius: 0; }
button.cell-button::after { border: none; }

.empty { text-align: center; padding: 64rpx 32rpx; color: var(--fg-1); font-size: 28rpx; }
.empty .empty-title { font-size: 32rpx; color: var(--fg-0); font-weight: 500; margin-bottom: 8rpx; }

.progress { height: 12rpx; border-radius: 6rpx; background: var(--fill); overflow: hidden; }
.progress-bar { height: 100%; border-radius: 6rpx; background: var(--brand); transition: width 0.4s ease; }

.fade-in { animation: fade-in 0.35s ease both; }
@keyframes fade-in { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: none; } }

.summary-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 24rpx; font-size: 30rpx; }
.row-line { position: relative; }
.row-line + .row-line::before { content: ""; position: absolute; top: 0; left: 32rpx; right: 0; border-top: 1rpx solid var(--line); }

/* Current charging card */
.charge-now { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20rpx; }
.charge-percent { font-size: 80rpx; font-weight: 600; line-height: 1; }
.charge-elapsed { text-align: right; font-size: 34rpx; }
.charge-line { display: flex; justify-content: space-between; margin: 20rpx 0 8rpx; }
.charge-error { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); color: var(--orange); }
.pulse { animation: pulse 2s ease-in-out infinite; }
@keyframes pulse { 50% { opacity: 0.55; } }
