.calendar { padding: 24rpx 16rpx; }
.row { display: grid; grid-template-columns: repeat(7, 1fr); row-gap: 8rpx; }
.weekday { text-align: center; font-size: 22rpx; color: var(--fg-1); padding-bottom: 12rpx; }
.day { display: flex; flex-direction: column; align-items: center; height: 104rpx; padding-top: 8rpx; border-radius: 12rpx; }
.day-hover { background: var(--fill); }
.number { width: 60rpx; height: 60rpx; line-height: 60rpx; text-align: center; border-radius: 30rpx; font-size: 30rpx; }
.number.today { background: var(--brand); color: #fff; font-weight: 600; }
.badge { display: flex; align-items: center; gap: 6rpx; height: 28rpx; font-size: 20rpx; font-weight: 600; color: var(--brand); }
.dot { width: 10rpx; height: 10rpx; border-radius: 5rpx; background: var(--brand); }
