.segmented { display: flex; margin: 16rpx 32rpx; padding: 4rpx; border-radius: 16rpx; background: var(--fill); }
.segment { flex: 1; text-align: center; padding: 12rpx 0; font-size: 28rpx; color: var(--fg-1); border-radius: 12rpx; transition: background 0.2s; }
.segment.active { background: var(--card); color: var(--fg-0); font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08); }
