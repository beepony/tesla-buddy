.map-card { padding: 0; overflow: hidden; }
.map { width: 100%; height: 800rpx; }
.placeholder { display: flex; align-items: center; justify-content: center; color: var(--fg-1); font-size: 28rpx; }
.stop { width: 24rpx; height: 24rpx; border-radius: 12rpx; margin-right: 24rpx; border: 6rpx solid var(--card); box-shadow: 0 0 0 2rpx var(--line); }
.stop.start { background: var(--brand); }
.stop.end { background: var(--blue); }
