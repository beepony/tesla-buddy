<view class="page" wx:if="{{view}}">
  <view class="section-title">
    <text class="strong">行程轨迹</text>
    <text class="num">{{view.distance}}</text>
  </view>
  <view class="card map-card">
    <view wx:if="{{loadingRoute && !map}}" class="map placeholder">正在加载行程轨迹…</view>
    <view wx:elif="{{!map}}" class="map placeholder">TeslaMate 尚未记录这次行程的位置数据。</view>
    <map wx:else class="map" markers="{{map.markers}}" polyline="{{map.polyline}}" include-points="{{map.includePoints}}" show-scale></map>
  </view>
  <view wx:if="{{routeMessage}}" class="notice">{{routeMessage}}</view>

  <view class="section-title">路线</view>
  <view class="cells">
    <view class="cell {{view.start.canOpen ? 'access' : ''}}" hover-class="{{view.start.canOpen ? 'cell-hover' : 'none'}}" bindtap="openStart">
      <view class="stop start"></view>
      <view class="cell-bd"><text class="muted tiny">出发</text><view class="bold">{{view.start.name}}</view><text class="cell-desc">{{view.start.time}}</text></view>
      <view class="cell-ft"></view>
    </view>
    <view class="cell {{view.end.canOpen ? 'access' : ''}}" hover-class="{{view.end.canOpen ? 'cell-hover' : 'none'}}" bindtap="openEnd">
      <view class="stop end"></view>
      <view class="cell-bd"><text class="muted tiny">到达</text><view class="bold">{{view.end.name}}</view><text class="cell-desc">{{view.end.time}}</text></view>
      <view class="cell-ft"></view>
    </view>
  </view>
  <view class="section-tips">点击地点可在地图中查看并选择导航应用。</view>

  <view class="section-title">行程概览</view>
  <view class="card">
    <view class="grid">
      <view class="tile" wx:for="{{view.tiles}}" wx:key="label">
        <view class="tile-label">{{item.label}}</view>
        <view class="tile-value num">{{item.value}}</view>
      </view>
    </view>
  </view>

  <block wx:if="{{view.facts.length}}">
    <view class="section-title">车辆表现</view>
    <view class="cells">
      <view class="cell" wx:for="{{view.facts}}" wx:key="label"><view class="cell-bd">{{item.label}}</view><view class="cell-ft num">{{item.value}}</view></view>
    </view>
  </block>

  <block wx:if="{{view.environment.length}}">
    <view class="section-title">环境</view>
    <view class="cells">
      <view class="cell" wx:for="{{view.environment}}" wx:key="label"><view class="cell-bd">{{item.label}}</view><view class="cell-ft num">{{item.value}}</view></view>
    </view>
  </block>
</view>
<state-view wx:else loading="{{loadingRoute}}" message="{{routeMessage}}" retry="{{false}}"></state-view>
