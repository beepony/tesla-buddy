<view class="page">
  <block wx:if="{{detail.rows.length > 0}}">
    <view class="section-title">{{detail.title || template.summary}}</view>
    <view class="cells">
      <view class="cell" wx:for="{{detail.rows}}" wx:key="label">
        <view class="cell-bd ellipsis">{{item.label}}</view>
        <view class="cell-ft num">{{item.value}}</view>
      </view>
    </view>
    <view wx:if="{{detail.note}}" class="section-tips">{{detail.note}}</view>
  </block>
  <view wx:else class="empty top-space">
    <image wx:if="{{template.icon}}" class="empty-icon" src="/assets/icons/{{template.icon}}.png"></image>
    <view class="empty-title">数据仍在积累</view>
    {{template.detail}}
  </view>
</view>
