<import src="/components/period-summary.wxml" />
<view class="page">
  <view class="gap"></view>
  <view class="card"><template is="period-summary" data="{{...summary}}" /></view>
  <block wx:if="{{charges.length > 0}}">
    <view class="section-title">充电明细 · {{charges.length}} 次</view>
    <view class="cells">
      <view wx:for="{{charges}}" wx:key="id" class="row-line"><charge-row charge="{{item}}"></charge-row></view>
    </view>
  </block>
  <view wx:else class="card empty top">
    <view class="empty-title">当天暂无充电记录</view>
    TeslaMate 在这一天没有记录到充电。
  </view>
  <view wx:if="{{message}}" class="notice warn">{{message}}</view>
</view>
