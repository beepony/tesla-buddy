.intro { padding: 32rpx 32rpx 8rpx; }
.intro-title { font-size: 44rpx; font-weight: 600; margin-bottom: 4rpx; }
.date-row { display: flex; align-items: center; justify-content: space-between; padding: 0 16rpx 24rpx; }
.date-pill { padding: 12rpx 32rpx; border-radius: 12rpx; background: var(--card); font-size: 30rpx; }
.date-arrow { width: 88rpx; height: 88rpx; border-radius: 44rpx; position: relative; }
.date-arrow::after { content: ""; position: absolute; top: 50%; left: 50%; width: 18rpx; height: 18rpx; border-top: 4rpx solid var(--fg-0); border-left: 4rpx solid var(--fg-0); }
.date-arrow.left::after { transform: translate(-30%, -50%) rotate(-45deg); }
.date-arrow.right::after { transform: translate(-70%, -50%) rotate(135deg); }
.big { font-size: 36rpx; }
.top { margin-top: 12rpx; }
