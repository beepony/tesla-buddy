<view class="page">
  <view class="section-title">家庭位置</view>
  <view class="cells">
    <view class="cell access" hover-class="cell-hover" bindtap="chooseHome" aria-role="button">
      <image class="cell-icon" src="/assets/icons/home.png"></image>
      <view class="cell-bd">设置家庭位置</view>
      <view class="cell-ft ellipsis home-name">{{homeName || '未设置'}}</view>
    </view>
  </view>
  <view wx:if="{{!homeKey}}" class="section-tips">设置家庭位置后，将自动隐藏在家停车。</view>

  <view class="section-title">当前停车</view>
  <view wx:if="{{current && currentIsHome}}" class="cells">
    <view class="cell"><image class="cell-icon" src="/assets/icons/home.png"></image><view class="cell-bd muted">车辆停在家中，本次不计入停车时长</view></view>
  </view>
  <view wx:elif="{{current}}" class="card fade-in">
    <view class="current-head">
      <view>
        <view class="muted small">已停车</view>
        <view class="elapsed num">{{current.elapsed}}</view>
      </view>
      <view class="timer-icon"><image src="/assets/icons/timer.png" mode="aspectFit"></image></view>
    </view>
    <view class="line"><text class="muted">停车地点</text><text class="ellipsis value">{{current.location}}</text></view>
    <view class="line"><text class="muted">开始时间</text><text class="value">{{current.start}}</text></view>
  </view>
  <view wx:elif="{{loading}}" class="card empty">正在读取…</view>
  <view wx:else class="card empty"><view class="empty-title">当前没有停车记录</view></view>

  <view class="section-title">最近停车</view>
  <view class="cells">
    <view wx:if="{{completed.length === 0}}" class="cell"><view class="cell-bd muted">暂无非家庭停车记录</view></view>
    <view wx:for="{{completed}}" wx:key="id" class="cell">
      <view class="cell-bd">
        <view class="session-head">
          <text class="bold ellipsis">{{item.location}}</text>
          <text class="brand bold num">{{item.duration}}</text>
        </view>
        <text class="cell-desc">{{item.range}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{message}}" class="notice warn">{{message}}</view>
</view>
