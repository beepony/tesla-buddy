.home-name { max-width: 360rpx; }
.current-head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 24rpx; margin-bottom: 8rpx; border-bottom: 1rpx solid var(--line); }
.elapsed { font-size: 64rpx; font-weight: 600; color: var(--brand); margin-top: 4rpx; }
.timer-icon { width: 96rpx; height: 96rpx; border-radius: 48rpx; background: var(--brand-weak); display: flex; align-items: center; justify-content: center; }
.timer-icon image { width: 48rpx; height: 48rpx; }
.line { display: flex; justify-content: space-between; gap: 24rpx; padding-top: 20rpx; font-size: 30rpx; }
.line .value { max-width: 440rpx; text-align: right; }
.session-head { display: flex; justify-content: space-between; gap: 24rpx; }
